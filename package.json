{
  "name": "hal-takip",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "build:web": "vite build",
    "build:android-web": "vite build --config vite.android.config.ts",
    "preview": "npm run build:web && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cloudflare:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cloudflare-bootstrap.ps1",
    "db:migrate:local": "wrangler d1 migrations apply hal-takip-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hal-takip-db --remote",
    "android:add": "cap add android",
    "android:sync": "npm run build:android-web && cap sync android",
    "android:assets": "capacitor-assets generate --android --assetPath assets --iconBackgroundColor \"#07111f\" --iconBackgroundColorDark \"#07111f\" --splashBackgroundColor \"#07111f\" --splashBackgroundColorDark \"#07111f\"",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/core": "8.5.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.1",
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260831.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "^5.9.2",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  }
}
